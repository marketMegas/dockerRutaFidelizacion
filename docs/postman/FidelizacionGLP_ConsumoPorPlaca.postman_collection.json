            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"placa\": \"ABC123\",\n  \"litros\": 12.50,\n  \"id_transaccion\": \"REEMPLAZAR_CON_ID_TRANSACCION_ANTERIOR\",\n  \"estacion_id\": \"EDS-01\"\n}"
        },
        "url": {
