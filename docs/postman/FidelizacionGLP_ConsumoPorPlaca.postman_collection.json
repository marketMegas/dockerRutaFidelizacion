        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"placa\": \"DEF456\",\n  \"litros\": 8.25,\n  \"id_transaccion\": \"{{$guid}}\",\n  \"estacion_id\": \"EDS-01\"\n}"
