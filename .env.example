# ============================================================
#  Plantilla de variables de entorno (local y VPS).
#  Copia a .env y rellena los valores. El .env real NUNCA va a git.
# ============================================================

# --- API ---
DEBUG=True
SECRET_KEY=cambiar_por_openssl_rand_base64_48
API_PREFIX=/fid-api
# Origenes permitidos (separados por coma). En produccion usa SOLO el dominio:
#   CORS_ORIGINS=https://fidelizacion.megas.com.co
# Para desarrollo local incluye los puertos de los front:
CORS_ORIGINS=https://fidelizacion.megas.com.co,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5139,http://127.0.0.1:5140,http://127.0.0.1:5174,http://127.0.0.1:5175

# --- Base de datos ---
# Local con Docker: usa el host postgres del compose
DATABASE_URL=postgresql+psycopg://fidelizacion:fidelizacion@db:5432/fidelizacion
# Local con SQLite (sin Docker): sqlite:///./fidelizacion.db
POSTGRES_USER=fidelizacion
POSTGRES_PASSWORD=fidelizacion
POSTGRES_DB=fidelizacion

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Administrador del panel ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_RATE_MAX=5
OTP_RATE_VENTANA=900

# --- Login del panel admin (anti fuerza bruta, por IP) ---
ADMIN_RATE_MAX=10
ADMIN_RATE_VENTANA=900

# --- Envio de SMS (codigo de confirmacion) ---
# debug = no envia, solo registra el codigo en logs (recomendado para empezar)
# http  = hace POST a SMS_API_URL con {to, from, text}
SMS_PROVIDER=debug
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=FidelizacionGLP

# --- Catalogo (premios y codigos) ---
# Archivo JSON fuente de verdad. En Docker vive en el volumen datos_catalogo.
CATALOGO_PATH=/app/data/catalogo.json
# Zona horaria del corte de mes y de los reportes
TZ_ESTACION=America/Bogota

# --- Conector / integracion con la estacion ---
# Clave que usa el conector para enviar ventas a la API
SYNC_API_KEY=dev-api-key
# Modo del conector: simulador | api | archivos
ZENCILLO_MODO=simulador
# Solo si ZENCILLO_MODO=api o archivos
ZENCILLO_API_URL=
ZENCILLO_API_KEY=
ZENCILLO_ARCHIVO=/datos/ventas_zencillo.csv
ESTACION_ID=EDS-01
