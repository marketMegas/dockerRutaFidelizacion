# Conexion con la API de fidelizacion (nuestro backend)
FID_API_URL=http://localhost:8002/fid-api
SYNC_API_KEY=dev-api-key
ESTACION_ID=EDS-01

# Modo de origen de ventas: simulador | api | archivos
ZENCILLO_MODO=simulador

# Solo si ZENCILLO_MODO=api (API REST de Zencillo en la nube)
# Endpoint que devuelve ventas (solicitar a Zencillo el contrato exacto)
ZENCILLO_API_URL=
ZENCILLO_API_KEY=

# Solo si ZENCILLO_MODO=archivos (export plano de Zencillo)
ZENCILLO_ARCHIVO=ventas_zencillo.csv

# Cada cuantos segundos consulta el origen en modo daemon
POLL_SEGUNDOS=30

# Archivo de la cola offline
COLA_ARCHIVO=cola_offline.json
